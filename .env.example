# Local development values only. Never commit real credentials.
NODE_ENV=development
# Runtime role: no BYPASSRLS, no DDL
DATABASE_URL=postgres://nmp_app:nmp_app_local@127.0.0.1:5432/nmp_dev
# Owner role: migrations only
MIGRATE_DATABASE_URL=postgres://127.0.0.1:5432/nmp_dev
REDIS_URL=redis://127.0.0.1:6379
API_PORT=4000
WEB_PORT=3100
API_URL=http://127.0.0.1:4000
# 32+ random bytes, base64. Encrypts TOTP secrets at rest.
SECRET_ENCRYPTION_KEY=change-me
UPLOAD_DIR=./var/uploads
