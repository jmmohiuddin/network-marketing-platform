# Local development values only. Never commit real credentials.
NODE_ENV=development
# Runtime role: no BYPASSRLS, no DDL
DATABASE_URL=postgres://nmp_app:nmp_app_local@127.0.0.1:5432/nmp_dev
# Owner role: migrations only
MIGRATE_DATABASE_URL=postgres://127.0.0.1:5432/nmp_dev
REDIS_URL=redis://127.0.0.1:6379
API_PORT=4000
WEB_PORT=3100
API_URL=http://127.0.0.1:4000
# 32+ random bytes, base64. Encrypts TOTP secrets at rest.
SECRET_ENCRYPTION_KEY=change-me
UPLOAD_DIR=./var/uploads
# Local mail drop: invitation and alert mails are written here as .eml files (no SMTP yet)
MAIL_DIR=./var/mail
WEB_URL=http://127.0.0.1:3100
# Secure cookies need HTTPS. Set false ONLY for local http development.
COOKIE_SECURE=true
# Max bytes per uploaded import file
IMPORT_MAX_FILE_BYTES=52428800
# Max bytes per uploaded evidence document (stored under UPLOAD_DIR)
EVIDENCE_MAX_FILE_BYTES=10485760
# API keys (FR-IAM-006): requests per minute per rate tier, longest rotation grace period
API_KEY_RATE_STANDARD_PER_MINUTE=120
API_KEY_RATE_HIGH_PER_MINUTE=1200
API_KEY_MAX_GRACE_MINUTES=10080
# Webhook delivery (FR-INT-001): request timeout, allowed target ports, retry backoff, give-up window
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_ALLOWED_PORTS=443
WEBHOOK_RETRY_BASE_SECONDS=60
WEBHOOK_RETRY_MAX_SECONDS=21600
WEBHOOK_GIVE_UP_HOURS=72
# Proxies whose X-Forwarded-For is trusted (comma-separated addresses, CIDRs, or loopback|linklocal|uniquelocal). Unset = trust none.
# Set to loopback when the web app's /v1 rewrite fronts the API, so API-key IP allow-lists see the client address.
TRUST_PROXY=
# Orders (D-B2-19): how far ahead of the server clock an order or event timestamp may be (clock skew)
ORDER_FUTURE_TOLERANCE_SECONDS=300
# Genealogy (D-B2-19): deepest authorisation walk on the system of record while the read model is stale (deeper = denied),
# and the largest page of tree children
GENEALOGY_FALLBACK_MAX_DEPTH=10000
GENEALOGY_PAGE_MAX=200
